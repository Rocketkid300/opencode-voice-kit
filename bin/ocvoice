#!/usr/bin/env bash
# Voice input for OpenCode on Wayland.
#
# Starts the local HTTP bridge (opencode-voice-typer) if needed, then runs
# opencode-voice.  Transcripts are delivered to the OpenCode chat that was
# active when recording started.  Standalone use falls back to typing into the
# focused window with wtype.
#
# Environment:
#   OPENCODE_VOICE_PORT      bridge port (default: 4096)
#   OPENCODE_VOICE_DEVICE    audio input (default: pulse)
#   OPENCODE_VOICE_MODEL     whisper model, e.g. base.en or small.en
#   OPENCODE_VOICE_NO_FOCUS  set to 1 to skip Hyprland window focusing
#   OPENCODE_VOICE_SESSION   hidden tmux session name (default: opencode-voice)
#   OPENCODE_VOICE_STATE_DIR state directory (default: ~/.local/state/opencode-voice)
#   OPENCODE_VOICE_TARGET_FILE  target-session file override
#   OPENCODE_VOICE_TARGET_TTL   target freshness in seconds (default: 120)
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PORT="${OPENCODE_VOICE_PORT:-4096}"
BRIDGE="${OPENCODE_VOICE_BRIDGE:-$SCRIPT_DIR/opencode-voice-typer}"
VOICE_BIN="${OPENCODE_VOICE_BIN:-$(command -v opencode-voice 2>/dev/null || true)}"
[ -n "$VOICE_BIN" ] || VOICE_BIN="$HOME/.cargo/bin/opencode-voice"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE_DIR/opencode-voice-typer.log"
VOICE_STATE_DIR="${OPENCODE_VOICE_STATE_DIR:-$STATE_DIR/opencode-voice}"
export OPENCODE_VOICE_STATE_DIR="$VOICE_STATE_DIR"
export OPENCODE_VOICE_TARGET_FILE="${OPENCODE_VOICE_TARGET_FILE:-$VOICE_STATE_DIR/target.json}"
mkdir -p "$VOICE_STATE_DIR"

if [ ! -x "$VOICE_BIN" ]; then
  echo "error: opencode-voice not found at $VOICE_BIN" >&2
  echo "install it with: WHISPER_DONT_GENERATE_BINDINGS=1 cargo install opencode-voice --locked" >&2
  exit 1
fi

if ! command -v wtype >/dev/null 2>&1; then
  echo "error: wtype is required to type transcripts on Wayland" >&2
  exit 1
fi

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_SESSION_TYPE:-}" != "wayland" ]; then
  echo "warning: no Wayland session detected; wtype needs Wayland." >&2
fi

# If the integrated background helper is already running, show its terminal
# instead of starting a second microphone user.
SESSION="${OPENCODE_VOICE_SESSION:-opencode-voice}"
if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$SESSION" 2>/dev/null; then
  if [ -n "${TMUX:-}" ]; then
    current_session=$(tmux display-message -p '#S' 2>/dev/null || true)
    if [ "$current_session" != "$SESSION" ]; then
      echo "Voice is already running in the background; switching to it..."
      exec tmux switch-client -t "$SESSION"
    fi
  else
    echo "Voice is already running in the background; attaching..."
    exec tmux attach-session -t "$SESSION"
  fi
fi

# Default to the PulseAudio/PipeWire input; override with OPENCODE_VOICE_DEVICE.
export OPENCODE_VOICE_DEVICE="${OPENCODE_VOICE_DEVICE:-pulse}"
export OPENCODE_VOICE_PORT="$PORT"

bridge_up() {
  local body
  body=$(curl -sf -m 1 "http://127.0.0.1:$PORT/" 2>/dev/null) || return 1
  case "$body" in
    *'"service": "opencode-voice-typer"'*) return 0 ;;
    *) return 1 ;;
  esac
}

if ! bridge_up; then
  mkdir -p "$STATE_DIR"
  bridge_args=(--port "$PORT")
  if [ "${OPENCODE_VOICE_NO_FOCUS:-0}" = "1" ]; then
    bridge_args+=(--no-focus)
  fi
  nohup "$BRIDGE" "${bridge_args[@]}" >>"$LOG" 2>&1 &
  for _ in $(seq 1 25); do
    bridge_up && break
    sleep 0.2
  done
fi

if ! bridge_up; then
  echo "error: voice bridge failed to start on port $PORT" >&2
  tail -n 5 "$LOG" >&2 || true
  exit 1
fi

if command -v opencode >/dev/null 2>&1 && ! opencode service status >/dev/null 2>&1; then
  echo "note: OpenCode's service does not appear to be running." >&2
  echo "      Text will still be typed into the focused window." >&2
fi

cat <<EOF

Voice input is ready.
  Hold Right Alt, speak, release  -> the OpenCode chat where you started
EOF
if [ "${OPENCODE_VOICE_NO_FOCUS:-0}" = "1" ]; then
  echo "  Standalone use types into the focused window"
else
  echo "  With no active chat, text is typed into the focused window"
fi
echo
if [ -t 0 ]; then
  echo "  Press q here to quit"
else
  echo "  Close this window or press Ctrl+C to stop"
fi
echo

model_args=()
if [ -n "${OPENCODE_VOICE_MODEL:-}" ]; then
  model_args=(--model "$OPENCODE_VOICE_MODEL")
fi

if [ ${#model_args[@]} -gt 0 ]; then
  exec "$VOICE_BIN" --no-handle-prompts "${model_args[@]}" "$@"
else
  exec "$VOICE_BIN" --no-handle-prompts "$@"
fi
