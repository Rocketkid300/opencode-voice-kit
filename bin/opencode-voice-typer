#!/usr/bin/env python3
"""Local HTTP bridge for opencode-voice -> the intended OpenCode chat.

OpenCode v2 removed the old /tui/append-prompt and /tui/submit-prompt
endpoints that opencode-voice 0.1.4 talks to.  This bridge implements just
enough of that API to deliver a transcript to the session that was active
when recording started.

The TUI plugin writes <state>/opencode-voice/target.json when a recording
begins.  When that target is fresh the bridge submits the transcript with
`opencode api POST /api/session/<id>/prompt`, so the text lands in the right
chat even if the user switched tabs (or apps) meanwhile.  The following
/tui/submit-prompt call is then acknowledged without pressing Return, which
would submit whatever happens to be focused.

When no fresh target exists (standalone ocvoice, a TUI on the home screen,
or an app that is not OpenCode), the bridge falls back to typing into the
focused window with wtype.  If a target exists but delivery fails, it does
not fall back: typing the transcript into another chat would be worse than
reporting the error.

Endpoints:
  GET  /                       health (used by opencode-voice)
  GET  /event                  SSE keep-alive (unused when prompts disabled)
  POST /tui/append-prompt      deliver {"text": "..."} to the target session
  POST /tui/submit-prompt      press Return only after a wtype fallback
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
STATE_DIR = os.environ.get("OPENCODE_VOICE_STATE_DIR") or os.path.join(
    STATE_HOME, "opencode-voice"
)
TARGET_PATH = os.environ.get("OPENCODE_VOICE_TARGET_FILE") or os.path.join(
    STATE_DIR, "target.json"
)
try:
    TARGET_TTL = float(os.environ.get("OPENCODE_VOICE_TARGET_TTL") or 120)
except ValueError:
    TARGET_TTL = 120.0
if TARGET_TTL <= 0:
    TARGET_TTL = 120.0
LOG_PATH = os.environ.get("OPENCODE_VOICE_LOG") or os.path.join(
    STATE_HOME, "opencode-voice-typer.log"
)
SESSION_RE = re.compile(r"^ses_[A-Za-z0-9]+$")
SUBMIT_WINDOW = 20.0
_log_lock = threading.Lock()
_inject_lock = threading.Lock()


def log(msg):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n"
    with _log_lock:
        try:
            os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
            with open(LOG_PATH, "a", encoding="utf-8") as fh:
                fh.write(line)
        except OSError:
            pass


def read_target():
    """Return a fresh target written by the TUI plugin, or None."""
    try:
        with open(TARGET_PATH, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or data.get("version") != 1:
        return None

    session_id = data.get("sessionID")
    if not isinstance(session_id, str) or not SESSION_RE.match(session_id):
        return None

    now_ms = time.time() * 1000
    updated = data.get("updatedAt")
    expires = data.get("expiresAt")
    if not isinstance(updated, (int, float)) or not isinstance(expires, (int, float)):
        return None
    if updated > now_ms + 5000 or expires <= now_ms:
        return None
    # A malformed or clock-skewed file must not stay authoritative forever.
    if now_ms - updated > TARGET_TTL * 1000:
        return None

    directory = data.get("directory")
    if not isinstance(directory, str) or not os.path.isdir(directory):
        directory = None

    title = data.get("title")
    if not isinstance(title, str):
        title = None

    return {
        "sessionID": session_id,
        "title": title,
        "directory": directory,
        "updatedAt": updated,
        "expiresAt": expires,
    }


def opencode_bin():
    candidates = [
        os.environ.get("OPENCODE_VOICE_OPENCODE"),
        shutil.which("opencode"),
        os.path.expanduser("~/.local/bin/opencode"),
        "/usr/bin/opencode",
    ]
    for candidate in candidates:
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def deliver_api(target, text):
    """Submit text to one session through the OpenCode CLI.

    Returns (ok, detail).  The CLI is used instead of raw HTTP because the
    local API requires authentication; the CLI already holds the credentials.
    """
    binary = opencode_bin()
    if not binary:
        return False, "opencode CLI not found (set OPENCODE_VOICE_OPENCODE)"

    command = [
        binary,
        "api",
        "POST",
        f"/api/session/{target['sessionID']}/prompt",
        "-d",
        json.dumps({"text": text}, ensure_ascii=False),
    ]
    cwd = target.get("directory") or None
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15,
            text=True,
        )
    except subprocess.TimeoutExpired:
        return False, "opencode api timed out"
    except (OSError, ValueError) as exc:
        return False, f"opencode api failed to start: {exc}"

    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        return False, detail or f"opencode api exited {result.returncode}"
    if not (result.stdout or "").strip():
        return False, "opencode api returned no response"
    return True, None


def wayland_display():
    """Return a usable Wayland display name, tolerating wayland-0 vs wayland-1."""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    current = os.environ.get("WAYLAND_DISPLAY")
    if current and os.path.exists(os.path.join(runtime, current)):
        return current
    sockets = sorted(glob.glob(os.path.join(runtime, "wayland-*")))
    if sockets:
        return os.path.basename(sockets[0])
    return current or "wayland-1"


def run_wtype(args, timeout=15):
    env = dict(os.environ)
    env["XDG_RUNTIME_DIR"] = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    env["WAYLAND_DISPLAY"] = wayland_display()
    return subprocess.run(
        ["wtype", *args],
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
    )


def active_window():
    """Best-effort Hyprland active-window info (full dict) for diagnostics."""
    try:
        out = subprocess.run(
            ["hyprctl", "activewindow", "-j"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            text=True,
        )
        info = json.loads(out.stdout or "{}")
        return info if isinstance(info, dict) and info.get("address") else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def opencode_window():
    """Find the most recently used OpenCode TUI window."""
    try:
        out = subprocess.run(
            ["hyprctl", "clients", "-j"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            text=True,
        )
        clients = json.loads(out.stdout or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None

    candidates = []
    for client in clients:
        title = client.get("title") or ""
        # OpenCode TUI windows are titled "OC | <session>".  Do not match
        # arbitrary browser tabs mentioning "opencode" -- typing there would
        # send the transcript to the wrong window.
        if title.startswith("OC |"):
            candidates.append(client)
    if not candidates:
        return None
    candidates.sort(key=lambda c: c.get("focusHistoryID", 9999))
    return candidates[0]


def focus_opencode():
    """Bring the OpenCode window forward. Returns its info, or None."""
    window = opencode_window()
    if not window:
        return None
    addr = window.get("address")
    if not addr:
        return None

    current = active_window()
    if current and current.get("address") == addr:
        return window

    commands = (
        # This system's Hyprland uses the Lua dispatcher.
        ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
        # Fallback for standard Hyprland.
        ["hyprctl", "dispatch", "focuswindow", f"address:{addr}"],
    )
    for cmd in commands:
        try:
            subprocess.run(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=2,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        time.sleep(0.15)
        current = active_window()
        if current and current.get("address") == addr:
            return window
    return None


class Handler(BaseHTTPRequestHandler):
    server_version = "opencode-voice-typer/1.1"

    def log_message(self, fmt, *args):
        log(f"{self.address_string()} {fmt % args}")

    def _send(self, code=200, body=None, ctype="application/json"):
        if body is None:
            body = {"ok": code < 400}
        raw = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _read_json(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        raw = self.rfile.read(length) if length else b"{}"
        try:
            data = json.loads(raw or b"{}")
            return data if isinstance(data, dict) else {}
        except (ValueError, TypeError):
            return {}

    def _route(self, kind):
        self.server.last_delivery = kind
        self.server.last_delivery_at = time.monotonic()

    def _append(self, text):
        target = read_target()
        if target:
            label = target["title"] or target["sessionID"]
            log(f"target: {target['sessionID']} ({label})")
            if self.server.dry_run:
                log(f"append-prompt (dry-run, routed to {target['sessionID']}): {text!r}")
                self._route("api")
                self._send(200, {"ok": True, "routed": True, "dryRun": True})
                return

            ok, error = deliver_api(target, text)
            if ok:
                log(f"delivered to {target['sessionID']}: {text!r}")
                self._route("api")
                self._send(200, {"ok": True, "routed": True, "sessionID": target["sessionID"]})
            else:
                # Do not fall through to wtype.  The correct chat is known but
                # unreachable; typing into the focused window could submit the
                # transcript to a different conversation.
                log(f"delivery to {target['sessionID']} failed: {error}")
                self._route("api-failed")
                self._send(
                    500,
                    {"error": error, "sessionID": target["sessionID"]},
                )
            return

        if self.server.dry_run:
            log(f"append-prompt (dry-run): {text!r}")
            self._route("wtype")
            self._send(200)
            return

        # No target: preserve standalone/ocvoice behavior and type into the
        # focused window.
        if not getattr(self.server, "no_focus", False):
            focus_opencode()
        window = active_window()
        if window:
            log(f"typing into: {window.get('class')} / {window.get('title')}")
        try:
            result = run_wtype(["--", text])
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            log(f"append-prompt: wtype failed to start: {exc}")
            self._route("wtype-failed")
            self._send(500, {"error": str(exc)})
            return
        if result.returncode != 0:
            err = result.stderr.decode(errors="replace").strip()
            log(f"append-prompt: wtype exit {result.returncode}: {err}")
            self._route("wtype-failed")
            self._send(500, {"error": err or "wtype failed"})
            return
        log(f"typed: {text!r}")
        self._route("wtype")
        self._send(200)

    def _submit(self):
        kind = self.server.last_delivery
        age = time.monotonic() - self.server.last_delivery_at
        if age > SUBMIT_WINDOW:
            kind = None
            self.server.last_delivery = None

        if kind in ("api", "api-failed"):
            self.server.last_delivery = None
            log(f"submit suppressed after API delivery (route={kind})")
            self._send(200)
            return

        if kind == "wtype-failed":
            self.server.last_delivery = None
            log("submit suppressed after failed wtype delivery")
            self._send(200)
            return

        if kind is None:
            # The append request was lost.  A fresh target means OpenCode was
            # the intended destination, so do not press Return blindly.
            target = read_target()
            if target:
                log(
                    "submit suppressed (fresh target "
                    f"{target['sessionID']} with no matching append)"
                )
                self._send(200)
                return

        self.server.last_delivery = None
        if self.server.dry_run:
            log("submit-prompt (dry-run)")
            self._send(200)
            return

        time.sleep(0.2)  # let the TUI consume the typed text first
        if not getattr(self.server, "no_focus", False):
            focus_opencode()
        try:
            result = run_wtype(["-k", "Return"])
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            log(f"submit-prompt: wtype failed to start: {exc}")
            self._send(500, {"error": str(exc)})
            return
        if result.returncode != 0:
            err = result.stderr.decode(errors="replace").strip()
            log(f"submit-prompt: wtype exit {result.returncode}: {err}")
            self._send(500, {"error": err or "wtype failed"})
            return
        log("submitted (Return)")
        self._send(200)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/event":
            # Keep the SSE client alive without emitting any events.
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            try:
                while True:
                    self.wfile.write(b": keepalive\n\n")
                    self.wfile.flush()
                    time.sleep(15)
            except (BrokenPipeError, ConnectionResetError, OSError):
                return
            return
        self._send(200, {"ok": True, "service": "opencode-voice-typer"})

    def do_POST(self):
        path = self.path.split("?", 1)[0]
        data = self._read_json()

        if path.startswith("/tui/append-prompt"):
            text = data.get("text")
            if not isinstance(text, str) or not text:
                log("append-prompt: empty text")
                self._send(200)
                return
            # Serialize deliveries so concurrent dictations cannot interleave
            # text or race the submit decision.
            with _inject_lock:
                self._append(text)
            return

        if path.startswith("/tui/submit-prompt"):
            with _inject_lock:
                self._submit()
            return

        # Keep the client happy for anything else (e.g. permission replies).
        self._send(200)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int, default=4096)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--dry-run", action="store_true",
                        help="log requests instead of injecting keys")
    parser.add_argument("--no-focus", action="store_true",
                        help="do not try to focus the OpenCode window (Hyprland only)")
    args = parser.parse_args()

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    server.daemon_threads = True
    server.dry_run = args.dry_run
    server.no_focus = args.no_focus or os.environ.get("OPENCODE_VOICE_NO_FOCUS") == "1"
    server.last_delivery = None
    server.last_delivery_at = 0.0
    log(
        f"listening on {args.host}:{args.port} "
        f"(dry_run={args.dry_run}, no_focus={server.no_focus}, target={TARGET_PATH})"
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
